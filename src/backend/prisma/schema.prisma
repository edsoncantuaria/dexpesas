// This file serves as a documentation and structural reference for the database.
// In a real project using Prisma, this schema would be used to generate the database client and types.
// The data models defined here should align with the types in `src/backend/models/definitions.ts`.

datasource db {
  provider = "postgresql" // Example database
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =================================
//        Authentication
// =================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  name      String
  password  String // In a real application, this would store a hash (e.g., from bcrypt).
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  gamificationProfile GamificationProfile?
  accounts            Account[]
  cards               Card[]
  transactions        Transaction[]
  unlockedAchievements UnlockedAchievement[]
}

// =================================
//        Gamification System
// =================================

model GamificationProfile {
  id            String   @id @default(cuid())
  level         Int      @default(1)
  xp            Int      @default(0)
  Alimentacao   Int      @default(0)
  Lazer         Int      @default(0)
  Transporte    Int      @default(0)
  Investimentos Int      @default(0)
  Vicios        Int      @default(0)
  Moradia       Int      @default(0)
  Saude         Int      @default(0)
  Educacao      Int      @default(0)
  Compras       Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

model Achievement {
  id          String   @id @default(cuid())
  nome        String   @unique
  descricao   String
  icon        String
  xp          Int
  createdAt   DateTime @default(now())

  // Relations
  unlockedBy  UnlockedAchievement[]
}

model UnlockedAchievement {
  id            String   @id @default(cuid())
  unlockedAt    DateTime @default(now())
  destacada     Boolean  @default(false)

  // Relations
  user          User   @relation(fields: [userId], references: [id])
  userId        String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  achievementId String

  @@unique([userId, achievementId])
}

// =================================
//        Financial Core
// =================================

model Account {
  id          String   @id @default(cuid())
  nome        String
  instituicao String
  tipo        AccountType
  saldo       Float // This would likely be calculated or handled carefully in a real system.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user         User          @relation(fields: [userId], references: [id])
  userId       String
  transactions Transaction[]
  cards        Card[] // Cards that can be paid from this account
}

model Card {
  id            String   @id @default(cuid())
  nome          String
  limite        Float
  diaFechamento Int
  diaVencimento Int
  bandeira      CardBrand
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user          User          @relation(fields: [userId], references: [id])
  userId        String
  transactions  Transaction[]
  debitAccount  Account?      @relation(fields: [accountId], references: [id]) // for auto-debit
  accountId     String?
}

model Transaction {
  id                String   @id @default(cuid())
  tipo              TransactionType
  descricao         String
  valor             Float
  data              DateTime
  pago              Boolean  @default(true)
  metodoPagamento   PaymentMethod
  categoria         String // Corresponds to GamificationAttribute names

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations for recurring/installments
  installmentId     String?
  installmentNumber Int?
  totalInstallments Int?

  // Relations
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  account   Account? @relation(fields: [accountId], references: [id])
  accountId String?
  card      Card?    @relation(fields: [cardId], references: [id])
  cardId    String?

  @@index([userId, data])
}

// =================================
//             Enums
// =================================

enum AccountType {
  corrente
  poupanca
  investimento
}

enum CardBrand {
  visa
  mastercard
  elo
  amex
}

enum TransactionType {
  receita
  despesa
}

enum PaymentMethod {
  debito
  credito
  pix
  dinheiro
}

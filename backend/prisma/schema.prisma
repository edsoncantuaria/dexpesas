datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum GamificationMode {
  FULL
  LITE
  OFF
}

enum ClanRole {
  LEADER
  ADMIN
  MEMBER
}

enum ClanInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum AccountType {
  corrente
  poupanca
  investimento
}

enum CardBrand {
  visa
  mastercard
  elo
  amex
}

enum CardStatus {
  ACTIVE
  BLOCKED
  CANCELLED
}

enum CardInvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

enum TransactionType {
  receita
  despesa
}

enum PaymentMethod {
  debito
  credito
  pix
  dinheiro
  transferencia
}

enum TransactionStatus {
  PENDING
  POSTED
  CANCELLED
  FAILED
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
}

enum ConditionType {
  CONTAINS
  EQUALS
  STARTS_WITH
  ENDS_WITH
}

enum NotificationType {
  TRANSACTION_CREATED
  PAYMENT_DUE
  LIMIT_ALERT
  ACHIEVEMENT_UNLOCKED
  BUDGET_ALERT
  UPCOMING_PAYMENT
  STREAK_AWARDED
  SECURITY_ALERT
  FAMILY_UPDATE
}

enum AutomationType {
  ROUND_UP
  GOAL_CONTRIBUTION
  BILL_PAY
}

enum ScheduleType {
  MANUAL
  DAILY
  WEEKLY
  MONTHLY
  THRESHOLD
}

enum ReconciliationStatus {
  PROCESSING
  PENDING_REVIEW
  COMPLETED
  FAILED
}

enum ImportedTransactionStatus {
  PENDING
  SUGGESTED
  RECONCILED
  DISCARDED
}

enum ImportedTransactionType {
  CREDIT
  DEBIT
}

enum AuditLogStatus {
  SUCCESS
  FAILURE
}

enum RecurrenceType {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  TRIMONTHLY
  SEMIANNUALLY
}

enum AiAnalysisType {
  HABIT_ANALYSIS
  OPPORTUNITY_ANALYSIS
}

enum CurrencyType {
  BRL
  USD
}

enum SecurityEventType {
  NEW_DEVICE
  PASSWORD_RESET
  TWO_FACTOR_CHALLENGE
}

enum MissionScope {
  USER
  GUILD
}

enum GameEventType {
  XP_MULTIPLIER
  ITEM_DROP
}

enum StreakType {
  DAILY_TRANSACTION
  NO_VICE_SPENDING
}

enum SplitMethod {
  EQUAL
  PERCENTAGE
  AMOUNT
}

enum BudgetType {
  MONTHLY
  WEEKLY
  CUSTOM
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum RecurringBillStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum BillPaymentStatus {
  PENDING
  PAID
  SKIPPED
  FAILED
}

enum CellBudgetType {
  CELL
  HYBRID
  PERSONAL
}

enum CellFundStatus {
  ACTIVE
  PAUSED
  COMPLETED
}

enum CellSplitTrigger {
  RECURRING_BILL
  ADHOC
  USAGE_BASED
}

enum CellSplitMethod {
  EQUAL
  WEIGHTED
  CONSUMPTION
  PAYER_REIMBURSED
}

enum CellBudgetRecurrence {
  MONTHLY
  WEEKLY
  BIWEEKLY
  CUSTOM
}

enum CellSharedAccountVisibility {
  MEMBERS
  ADMINS
  CUSTOM
}

enum InvestmentPriority {
  investir
  lazer
  balanceado
}

enum InvestmentPlanStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum InvestmentContributionStatus {
  PENDING
  EXECUTED
  FAILED
}

enum InvestmentContributionSource {
  MANUAL
  AUTOMATION
  WINDFALL
  AI_SUGGESTION
}

enum AlertType {
  DUE_DATE
  LIMIT_WARNING
  UNUSUAL_SPENDING
  OVERDUE
  PAYMENT_SUCCESS
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum CategoryClassificationType {
  ESSENTIAL
  LEISURE
  INVESTMENT
  OTHER
}

model User {
  id                                 String           @id @default(cuid())
  name                               String
  username                           String           @unique
  email                              String           @unique
  password                           String
  age                                Int?
  gender                             String?
  avatarUrl                          String?
  role                               Role             @default(USER)
  isAdmin                            Boolean          @default(false)
  firstOpen                          Boolean          @default(true)
  futureProjectionCount              Int              @default(3)
  hasCompletedTutorial               Boolean          @default(false)
  hasCompletedMigration              Int              @default(0) // 0 = não iniciado, 1 = concluído, 2 = pulado
  daysUntilDueReminder               Int              @default(3)
  enableAchievementNotifications     Boolean          @default(true)
  enableBudgetNotifications          Boolean          @default(true)
  enableLimitAlerts                  Boolean          @default(true)
  enableUpcomingPaymentNotifications Boolean          @default(true)
  enableOcr                          Boolean          @default(false)
  enableDailySummary                 Boolean          @default(false)
  enableBudgetSuggestion             Boolean          @default(false)
  enableReconciliationAi             Boolean          @default(false)
  enableGoalProjection               Boolean          @default(false)
  habilitarDescricaoInteligente      Boolean          @default(true)
  dashboardLayout                    Json?            @default("[]")
  professionalSituation              String?
  monthlyIncomeRange                 String?
  investmentProfile                  String?
  mainFinancialGoal                  String?
  fixedMonthlyIncome                 Decimal?         @db.Decimal(18, 2)
  phoneNumber                        String?
  phoneVerified                      Boolean          @default(false)
  emailVerified                      Boolean          @default(false)
  emailVerificationToken             String?
  emailVerificationExpires           DateTime?
  resetPasswordToken                 String?
  resetPasswordExpires               DateTime?
  twoFactorEnabled                   Boolean          @default(false)
  twoFactorSecret                    String?
  favoriteCategories                 Json?            @default("[]")
  dashboardPreferences               Json?            @default("{}")
  hideFamilyMode                     Boolean          @default(false)
  lastSecurityNotificationAt         DateTime?
  pushSubscription                   String?          @db.Text
  gamificationMode                   GamificationMode @default(FULL)
  level                              Int              @default(1)
  xp                                 Int              @default(0)
  weeklyXp                           Int              @default(0)
  lastWeeklyReset                    DateTime         @default(now())
  heroClass                          String?
  createdAt                          DateTime         @default(now())
  updatedAt                          DateTime         @updatedAt

  // --- Relações ---
  clanMemberships               ClanMember[]                @relation("UserToClan")
  ownedClan                     Clan?                       @relation("ClanLeader")
  clanInvites                   ClanInvite[]                @relation("UserInvites")
  sharedExpenseParticipations   SharedExpenseParticipant[]  @relation("User_SharedExpenseParticipants")
  createdSharedExpenses         SharedExpense[]             @relation("ExpenseCreator")
  accounts                      Account[]
  cards                         Card[]
  transactions                  Transaction[]
  unlockedAchievements          UnlockedAchievement[]
  notifications                 Notification[]
  cellEvents                    CellEvent[]                 @relation("UserCellEvents")
  budgets                       Budget[]
  goals                         Goal[]
  automations                   Automation[]
  categorizationRules           CategorizationRule[]
  reconciliations               Reconciliation[]
  importTemplates               ImportTemplate[]
  auditLogs                     AuditLog[]
  aiAnalyses                    AiAnalysis[]
  tags                          Tag[]
  migrationDraft                MigrationDraft?
  categories                    Category[]
  userMissions                  UserMission[]
  inventoryItems                UserItem[]
  streaks                       UserStreak[]
  legacyRuins                   LegacyRuin[]
  recurringBills                RecurringBill[]
  attachments                   Attachment[]
  devices                       UserDevice[]
  securityEvents                SecurityEvent[]
  favoriteCategoryLinks         UserFavoriteCategory[]
  cellFundContributions         CellFundContribution[]
  custodiedCellFunds            CellFund[]                  @relation("UserCustodiedFunds")
  equilibriumSettlementPayments CellEquilibriumSettlement[] @relation("EquilibriumSettlementPayer")
  equilibriumSettlementReceipts CellEquilibriumSettlement[] @relation("EquilibriumSettlementReceiver")
  investmentPlan                InvestmentPlan?
  investmentHoldings            InvestmentHolding[]
  investmentContributions       InvestmentContribution[]
  investmentSnapshots           InvestmentSnapshot[]
  investmentNudgeConversions    InvestmentNudgeConversion[]
  cardAlerts                    CardAlert[]                 @relation("User_CardAlerts")
  categoryClassifications       CategoryClassification[]
}

model Clan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  iconUrl     String?
  balance     Decimal  @default(0) @db.Decimal(18, 4)
  level       Int      @default(1)
  xp          BigInt   @default(0)
  /// Regras de governança da família
  policies    Json?
  maxMembers  Int      @default(50)
  leaderId    String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // --- Relações ---
  leader                     User                        @relation("ClanLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members                    ClanMember[]                @relation("ClanToMembers")
  invites                    ClanInvite[]
  goals                      Goal[]
  sharedExpenses             SharedExpense[]
  events                     CellEvent[]                 @relation("ClanCellEvents")
  cellBudgets                CellBudget[]
  cellFunds                  CellFund[]
  cellSplitRules             CellSplitRule[]
  cellEquilibriumSnapshots   CellEquilibriumSnapshot[]
  cellEquilibriumSettlements CellEquilibriumSettlement[]
  sharedAccounts             CellSharedAccount[]         @relation("ClanSharedAccounts")

  @@map("family_cells")
}

model ClanMember {
  userId      String
  clanId      String
  role        ClanRole @default(MEMBER)
  joinedAt    DateTime @default(now())
  /// Permissões granulares (manageMembers, manageBudgets, recordTransactions, moveFunds, viewPersonalBudget, manageFunds, vote, approveSplits)
  permissions Json     @default("{}") @map("permissions_json")

  // --- Relações ---
  user User @relation("UserToClan", fields: [userId], references: [id], onDelete: Cascade)
  clan Clan @relation("ClanToMembers", fields: [clanId], references: [id], onDelete: Cascade)

  @@id([userId, clanId])
  @@map("cell_members")
}

model ClanInvite {
  id            String           @id @default(cuid())
  clanId        String
  invitedUserId String
  inviterId     String
  status        ClanInviteStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  expiresAt     DateTime

  // --- Relações ---
  clan        Clan @relation(fields: [clanId], references: [id], onDelete: Cascade)
  invitedUser User @relation("UserInvites", fields: [invitedUserId], references: [id], onDelete: Cascade)

  @@unique([clanId, invitedUserId])
  @@map("cell_invites")
}

model SharedExpense {
  id             String      @id @default(cuid())
  clanId         String
  creatorId      String
  description    String
  totalAmount    Decimal     @db.Decimal(18, 4)
  splitMethod    SplitMethod
  categoryId     String
  expenseDate    DateTime    @default(now())
  createdAt      DateTime    @default(now())
  splitAppliedAt DateTime?

  // --- Relações ---
  clan         Clan                       @relation(fields: [clanId], references: [id], onDelete: Cascade)
  creator      User                       @relation("ExpenseCreator", fields: [creatorId], references: [id], onDelete: NoAction)
  category     Category                   @relation("Category_SharedExpense", fields: [categoryId], references: [id], onDelete: NoAction)
  participants SharedExpenseParticipant[] @relation("SharedExpense_Participants")

  @@map("cell_expenses")
}

model SharedExpenseParticipant {
  id                   String  @id @default(cuid())
  sharedExpenseId      String
  userId               String
  amountOwed           Decimal @db.Decimal(18, 4)
  defaultAccountId     String?
  createdTransactionId String  @unique

  // --- Relações ---
  sharedExpense  SharedExpense @relation("SharedExpense_Participants", fields: [sharedExpenseId], references: [id], onDelete: Cascade)
  user           User          @relation("User_SharedExpenseParticipants", fields: [userId], references: [id], onDelete: Cascade)
  defaultAccount Account?      @relation("ParticipantDefaultAccount", fields: [defaultAccountId], references: [id], onDelete: SetNull)
  transaction    Transaction   @relation("GeneratedTransactionForParticipant", fields: [createdTransactionId], references: [id])

  @@unique([sharedExpenseId, userId])
  @@map("cell_expense_splits")
}

model CellBudget {
  id             String               @id @default(cuid())
  cellId         String
  categoryId     String?
  label          String?
  type           CellBudgetType       @default(CELL)
  recurrenceType CellBudgetRecurrence @default(MONTHLY)
  recurrenceDays Int?
  splitConfig    Json?
  fundId         String?
  limit          Decimal              @db.Decimal(18, 4)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  lastSyncedAt   DateTime?

  // --- Relações ---
  cell              Clan                   @relation(fields: [cellId], references: [id], onDelete: Cascade)
  category          Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  fund              CellFund?              @relation("CellFundToBudgets", fields: [fundId], references: [id], onDelete: SetNull)
  fundContributions CellFundContribution[] @relation("BudgetToContribution")
  personalMirrors   Budget[]               @relation("BudgetToCellBudget")

  @@index([cellId])
  @@index([cellId, type])
  @@map("cell_budgets")
}

model CellFund {
  id                    String         @id @default(cuid())
  cellId                String
  name                  String
  targetAmount          Decimal        @db.Decimal(18, 4)
  currentAmount         Decimal        @default(0) @db.Decimal(18, 4)
  usagePolicy           Json?
  /// Responsável legal pela caixinha
  custodianId           String?
  /// Rastro para o espelho pessoal/conta usada no mundo real
  custodianAccountLabel String?
  /// Configurações de aporte da família
  depositInstructions   Json?
  /// Quais papéis podem sacar
  withdrawalRoles       Json           @default("[\"LEADER\"]")
  /// Se deve mostrar o espelho na visão pessoal
  mirrorToCustodian     Boolean        @default(false)
  status                CellFundStatus @default(ACTIVE)
  goalDeadline          DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  // --- Relações ---
  cell          Clan                   @relation(fields: [cellId], references: [id], onDelete: Cascade)
  custodian     User?                  @relation("UserCustodiedFunds", fields: [custodianId], references: [id], onDelete: SetNull)
  contributions CellFundContribution[]
  budgets       CellBudget[]           @relation("CellFundToBudgets")
  goal          Goal?                  @relation("CellFundGoal")

  @@index([cellId])
  @@map("cell_funds")
}

model CellFundContribution {
  id           String   @id @default(cuid())
  fundId       String
  userId       String
  amount       Decimal  @db.Decimal(18, 4)
  source       String?
  fromBudgetId String?
  metadata     Json?
  createdAt    DateTime @default(now())

  // --- Relações ---
  fund       CellFund    @relation(fields: [fundId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromBudget CellBudget? @relation("BudgetToContribution", fields: [fromBudgetId], references: [id], onDelete: SetNull)

  @@index([fundId, createdAt])
  @@map("cell_fund_contributions")
}

model CellSharedAccount {
  id           String                      @id @default(cuid())
  cellId       String
  accountId    String
  visibility   CellSharedAccountVisibility @default(MEMBERS)
  allowedRoles Json                        @default("[]")
  metadata     Json?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  // --- Relações ---
  cell    Clan    @relation("ClanSharedAccounts", fields: [cellId], references: [id], onDelete: Cascade)
  account Account @relation("AccountSharedCells", fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([cellId, accountId])
  @@index([cellId])
  @@index([accountId])
  @@map("cell_shared_accounts")
}

model CellSplitRule {
  id                String           @id @default(cuid())
  cellId            String
  name              String
  trigger           CellSplitTrigger @default(ADHOC)
  method            CellSplitMethod  @default(EQUAL)
  weightsConfig     Json?
  consumptionMetric String?
  autoReimburse     Boolean          @default(false)
  active            Boolean          @default(true)
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // --- Relações ---
  cell Clan @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@index([cellId, active])
  @@map("cell_split_rules")
}

model CellEquilibriumSnapshot {
  id             String   @id @default(cuid())
  cellId         String
  referenceMonth String
  summary        Json
  createdAt      DateTime @default(now())

  // --- Relações ---
  cell Clan @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@unique([cellId, referenceMonth])
  @@map("cell_equilibrium_snapshots")
}

model CellEquilibriumSettlement {
  id             String   @id @default(cuid())
  cellId         String
  payerId        String
  receiverId     String
  amount         Decimal  @db.Decimal(18, 4)
  notes          String?
  referenceMonth String
  createdAt      DateTime @default(now())

  // --- Relações ---
  cell     Clan @relation(fields: [cellId], references: [id], onDelete: Cascade)
  payer    User @relation("EquilibriumSettlementPayer", fields: [payerId], references: [id], onDelete: Cascade)
  receiver User @relation("EquilibriumSettlementReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([cellId])
  @@map("cell_equilibrium_settlements")
}

model CellEvent {
  id               String   @id @default(cuid())
  cellId           String
  actorId          String?
  type             String
  title            String?
  description      String?
  payload          Json?
  entityId         String?
  entityType       String?
  visibility       String   @default("CELL")
  sourceAuditLogId String?  @unique
  createdAt        DateTime @default(now())

  // --- Relações ---
  cell  Clan  @relation("ClanCellEvents", fields: [cellId], references: [id], onDelete: Cascade)
  actor User? @relation("UserCellEvents", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([cellId, createdAt])
  @@index([entityId, entityType])
  @@map("cell_events")
}

model LegacyRuin {
  id                   String   @id @default(cuid())
  userId               String
  /// Nome da dívida, ex: Financiamento Veículo
  name                 String
  totalAmountPaid      Decimal  @db.Decimal(18, 4)
  totalInterestPaid    Decimal? @db.Decimal(18, 4)
  startDate            DateTime
  endDate              DateTime
  originalRecurrenceId String   @unique

  // --- Relações ---
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStreak {
  id            String     @id @default(cuid())
  userId        String
  type          StreakType
  currentStreak Int        @default(0)
  longestStreak Int        @default(0)
  lastCheckedAt DateTime

  // --- Relações ---
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model GameEvent {
  id          String        @id @default(cuid())
  type        GameEventType
  description String
  multiplier  Float?
  itemId      String?
  isActive    Boolean       @default(true)
  startAt     DateTime
  endAt       DateTime

  // --- Relações ---
  item Item? @relation(fields: [itemId], references: [id], onDelete: SetNull)
}

model Mission {
  id            String       @id @default(cuid())
  title         String
  description   String
  scope         MissionScope @default(USER)
  xpReward      Int
  itemRewardId  String?
  minLevel      Int          @default(1)
  requiredClass String?
  triggerSpec   Json
  isRepeatable  Boolean      @default(false)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  // --- Relações ---
  userMissions UserMission[]
}

model UserItem {
  id       String  @id @default(cuid())
  userId   String
  itemId   String
  quantity Int     @default(1)
  equipped Boolean @default(false)

  // --- Relações ---
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Account {
  id            String       @id @default(cuid())
  nome          String
  instituicao   String
  bankCode      String?
  agencyNumber  String?
  agencyDigit   String?
  accountNumber String?
  accountDigit  String?
  tipo          AccountType
  currency      CurrencyType @default(BRL)
  saldoInicial  Decimal      @db.Decimal(18, 4)
  color         String?
  icone         String?
  isArchived    Boolean      @default(false)
  userId        String

  // --- Relações ---
  user                               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions                       Transaction[]              @relation("AccountTransactions")
  counterTransactions                Transaction[]              @relation("Transaction_counterAccount")
  reconciliations                    Reconciliation[]
  goals                              Goal[]
  cardsForPayment                    Card[]                     @relation("Card_paymentAccount")
  ledgerEntries                      LedgerEntry[]
  recurringBills                     RecurringBill[]            @relation("RecurringBill_BillAccount")
  autoPayRecurringBills              RecurringBill[]            @relation("RecurringBill_AutoPayAccount")
  budgetAccounts                     Budget[]                   @relation("Budget_account")
  sharedCells                        CellSharedAccount[]        @relation("AccountSharedCells")
  sharedExpenseDefaultParticipants   SharedExpenseParticipant[] @relation("ParticipantDefaultAccount")
  investmentHoldings                 InvestmentHolding[]
  investmentContributionDestinations InvestmentContribution[]   @relation("InvestmentContributionDestination")
  investmentContributionSources      InvestmentContribution[]   @relation("InvestmentContributionSource")
}

model Card {
  id                    String        @id @default(cuid())
  nome                  String
  limite                Decimal       @db.Decimal(18, 4)
  diaFechamento         Int
  diaVencimento         Int
  closingDayGap         Int              @default(7) // Dias entre fechamento e vencimento
  bandeira              CardBrand
  status                CardStatus    @default(ACTIVE)
  rewardsType           String?
  rewardsProgram        String?
  rewardsConversionRate Decimal?      @db.Decimal(10, 4)
  lastFourDigits        String?
  issuer                String?
  billingCurrency       CurrencyType  @default(BRL)
  currencyForConversion CurrencyType? @default(BRL)
  currentInvoiceAmount  Decimal       @default(0) @db.Decimal(18, 4)
  availableLimit        Decimal?      @db.Decimal(18, 4)
  jurosRotativo         Decimal?      @db.Decimal(10, 4)
  userId                String
  paymentAccountId      String?
  // Cashback fields
  defaultCashbackRate       Decimal?  @default(0) @db.Decimal(5, 2)
  totalCashbackEarned       Decimal   @default(0) @db.Decimal(18, 4)
  cashbackExpiresAt         DateTime?
  cashbackRedemptionMinimum Decimal?  @db.Decimal(10, 2)

  // --- Relações ---
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount        Account?         @relation("Card_paymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  transactions          Transaction[]    @relation("CardTransactions")
  reconciliations       Reconciliation[]
  invoices              CardInvoice[]    @relation("CardInvoice_Card")
  billingRecurringBills RecurringBill[]  @relation("RecurringBill_BillCard")
  autoPayRecurringBills RecurringBill[]  @relation("RecurringBill_AutoPayCard")
  alerts                CardAlert[]      @relation("Card_Alerts")
}

model Transaction {
  id                         String            @id @default(cuid())
  valor                      Decimal           @db.Decimal(18, 4)
  descricao                  String
  tipo                       TransactionType
  data                       DateTime
  metodoPagamento            PaymentMethod
  currency                   CurrencyType      @default(BRL)
  status                     TransactionStatus @default(POSTED)
  pago                       Boolean           @default(true)
  notes                      String?           @db.Text
  installment                Boolean?          @default(false)
  installmentId              String?
  installmentNumber          Int?
  totalInstallments          Int?
  withInterest               Boolean?          @default(false)
  interestRate               Decimal?          @db.Decimal(10, 4)
  valorTotal                 Decimal?          @db.Decimal(18, 4)
  totalWithInterest          Decimal?          @db.Decimal(18, 4)
  balanceAfter               Decimal?          @db.Decimal(18, 4)
  recurrenceType             RecurrenceType?
  recorrenciaId              String?
  attachmentUrl              String?
  bankReference              String?
  authorizationCode          String?
  merchantName               String?
  merchantCategory           String?
  counterparty               String?
  postedAt                   DateTime?
  clearedAt                  DateTime?
  isTransfer                 Boolean           @default(false)
  counterAccountId           String?
  transferGroupId            String?
  isReconciled               Boolean           @default(false)
  isInvoicePayment           Boolean           @default(false)
  finalizedGoalId            String?
  // Cashback fields
  cashbackAmount             Decimal?          @db.Decimal(10, 4)
  cashbackPercentage         Decimal?          @db.Decimal(5, 2)
  userId                     String
  accountId                  String?
  cardId                     String?
  categoryId                 String?
  importedTransactionId      String?           @unique
  sharedExpenseParticipantId String?           @unique

  // --- Relações ---
  user                          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                       Account?                  @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  counterAccount                Account?                  @relation("Transaction_counterAccount", fields: [counterAccountId], references: [id], onDelete: SetNull)
  card                          Card?                     @relation("CardTransactions", fields: [cardId], references: [id], onDelete: Cascade)
  category                      Category?                 @relation("Transaction_category", fields: [categoryId], references: [id], onDelete: SetNull)
  roundUpEntry                  RoundUpEntry?             @relation("RoundUpEntry_transaction")
  importedTransaction           ImportedTransaction?      @relation("ManualToImportedTransaction")
  goalContributions             GoalContribution[]        @relation("GoalContribution_debitTransaction")
  sharedExpenseParticipant      SharedExpenseParticipant? @relation("GeneratedTransactionForParticipant")
  tags                          Tag[]
  ledgerEntries                 LedgerEntry[]             @relation("LedgerEntry_Transaction")
  cardInvoiceItems              CardInvoiceItem[]         @relation("Transaction_CardInvoiceItems")
  billOccurrences               BillOccurrence[]          @relation("Transaction_BillOccurrences")
  attachments                   Attachment[]              @relation("Transaction_Attachments")
  investmentContributionDebits  InvestmentContribution[]  @relation("InvestmentContributionDebit")
  investmentContributionCredits InvestmentContribution[]  @relation("InvestmentContributionCredit")

  @@index([recorrenciaId])
  @@index([installmentId])
  @@index([userId, data])
  @@index([status])
  @@index([bankReference])
  @@index([transferGroupId])
}

model LedgerEntry {
  id            String          @id @default(cuid())
  transactionId String
  accountId     String
  direction     LedgerDirection
  amount        Decimal         @db.Decimal(18, 4)
  currency      CurrencyType    @default(BRL)
  exchangeRate  Decimal?        @db.Decimal(18, 8)
  createdAt     DateTime        @default(now())

  // --- Relações ---
  transaction Transaction @relation("LedgerEntry_Transaction", fields: [transactionId], references: [id], onDelete: Cascade)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([transactionId, accountId, direction])
  @@index([transactionId])
  @@index([accountId])
}

model CardInvoice {
  id              String            @id @default(cuid())
  cardId          String
  referenceMonth  String
  startDate       DateTime
  endDate         DateTime
  closingDate     DateTime
  dueDate         DateTime
  status          CardInvoiceStatus @default(OPEN)
  amountDue       Decimal           @db.Decimal(18, 4)
  amountPaid      Decimal           @default(0) @db.Decimal(18, 4)
  minimumPayment  Decimal?          @db.Decimal(18, 4)
  previousBalance Decimal?          @db.Decimal(18, 4)
  generatedAt     DateTime          @default(now())

  // --- Relações ---
  card  Card              @relation("CardInvoice_Card", fields: [cardId], references: [id], onDelete: Cascade)
  items CardInvoiceItem[] @relation("CardInvoice_Items")

  @@index([cardId, referenceMonth])
}

model CardInvoiceItem {
  id            String          @id @default(cuid())
  invoiceId     String
  transactionId String?
  description   String
  type          TransactionType
  amount        Decimal         @db.Decimal(18, 4)
  createdAt     DateTime        @default(now())

  // --- Relações ---
  invoice     CardInvoice  @relation("CardInvoice_Items", fields: [invoiceId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation("Transaction_CardInvoiceItems", fields: [transactionId], references: [id], onDelete: SetNull)
}

model RecurringBill {
  id               String              @id @default(cuid())
  userId           String
  description      String
  amount           Decimal             @db.Decimal(18, 4)
  currency         CurrencyType        @default(BRL)
  type             TransactionType
  status           RecurringBillStatus @default(ACTIVE)
  recurrenceType   RecurrenceType
  dueDayOfMonth    Int?
  startDate        DateTime
  endDate          DateTime?
  nextOccurrenceAt DateTime?
  remindDaysBefore Int                 @default(2)
  autopayEnabled   Boolean             @default(false)
  autoPayAccountId String?
  autoPayCardId    String?
  accountId        String?
  cardId           String?
  categoryId       String?
  notes            String?             @db.Text
  lastGeneratedAt  DateTime?

  // --- Relações ---
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        Account?         @relation("RecurringBill_BillAccount", fields: [accountId], references: [id], onDelete: SetNull)
  card           Card?            @relation("RecurringBill_BillCard", fields: [cardId], references: [id], onDelete: SetNull)
  category       Category?        @relation("RecurringBill_category", fields: [categoryId], references: [id], onDelete: SetNull)
  autoPayAccount Account?         @relation("RecurringBill_AutoPayAccount", fields: [autoPayAccountId], references: [id], onDelete: SetNull)
  autoPayCard    Card?            @relation("RecurringBill_AutoPayCard", fields: [autoPayCardId], references: [id], onDelete: SetNull)
  occurrences    BillOccurrence[] @relation("RecurringBill_Occurrences")
}

model BillOccurrence {
  id            String            @id @default(cuid())
  billId        String
  dueDate       DateTime
  amount        Decimal           @db.Decimal(18, 4)
  status        BillPaymentStatus @default(PENDING)
  paidAt        DateTime?
  transactionId String?
  notes         String?           @db.Text

  // --- Relações ---
  bill        RecurringBill @relation("RecurringBill_Occurrences", fields: [billId], references: [id], onDelete: Cascade)
  transaction Transaction?  @relation("Transaction_BillOccurrences", fields: [transactionId], references: [id], onDelete: SetNull)
  attachments Attachment[]  @relation("BillOccurrence_Attachments")
}

model Attachment {
  id               String   @id @default(cuid())
  url              String
  mimeType         String?
  size             Int?
  description      String?
  uploadedAt       DateTime @default(now())
  userId           String
  transactionId    String?
  billOccurrenceId String?

  // --- Relações ---
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction    Transaction?    @relation("Transaction_Attachments", fields: [transactionId], references: [id], onDelete: SetNull)
  billOccurrence BillOccurrence? @relation("BillOccurrence_Attachments", fields: [billOccurrenceId], references: [id], onDelete: Cascade)
}

model Tag {
  id     String @id @default(cuid())
  name   String
  userId String

  // --- Relações ---
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

model Category {
  id               String          @id @default(cuid())
  nome             String
  label            String
  icon             String?
  type             TransactionType @default(despesa)
  parentCategoryId String?
  userId           String?

  // --- Relações ---
  transactions        Transaction[]              @relation("Transaction_category")
  budgets             Budget[]                   @relation("Budget_category")
  categorizationRules CategorizationRule[]       @relation("CategorizationRule_category")
  sharedExpenses      SharedExpense[]            @relation("Category_SharedExpense")
  recurringBills      RecurringBill[]            @relation("RecurringBill_category")
  cellBudgets         CellBudget[]
  parentCategory      Category?                  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcategories       Category[]                 @relation("CategoryHierarchy")
  favoriteUsers       UserFavoriteCategory[]
  classifications     CategoryClassification[]
  user                User?                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nome])
  @@index([parentCategoryId])
}

model Budget {
  id               String       @id @default(cuid())
  month            String?
  limit            Decimal      @db.Decimal(18, 4)
  rollover         Boolean      @default(false)
  type             BudgetType   @default(MONTHLY)
  startDate        DateTime?
  endDate          DateTime?
  currency         CurrencyType @default(BRL)
  includeTransfers Boolean      @default(false)
  userId           String
  categoryId       String
  accountId        String?
  cellBudgetId     String?

  // --- Relações ---
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category    @relation("Budget_category", fields: [categoryId], references: [id], onDelete: Cascade)
  account    Account?    @relation("Budget_account", fields: [accountId], references: [id], onDelete: SetNull)
  cellBudget CellBudget? @relation("BudgetToCellBudget", fields: [cellBudgetId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, type, month, startDate, endDate, cellBudgetId])
  @@index([userId, startDate, endDate])
  @@index([userId, month])
}

model Goal {
  id            String     @id @default(cuid())
  name          String
  targetAmount  Decimal    @db.Decimal(18, 4)
  currentAmount Decimal    @default(0) @db.Decimal(18, 4)
  status        GoalStatus @default(IN_PROGRESS)
  deadline      DateTime?
  imageUrl      String?
  createdAt     DateTime   @default(now())
  userId        String?
  accountId     String?
  clanId        String?
  cellFundId    String?    @unique

  // --- Relações ---
  user               User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  clan               Clan?               @relation(fields: [clanId], references: [id], onDelete: Cascade)
  cellFund           CellFund?           @relation("CellFundGoal", fields: [cellFundId], references: [id], onDelete: Cascade)
  contributions      GoalContribution[]  @relation("GoalContribution_goal")
  automation         Automation?         @relation("GoalAutomation")
  investmentHoldings InvestmentHolding[]
}

model GoalContribution {
  id                 String   @id @default(cuid())
  amount             Decimal  @db.Decimal(18, 4)
  date               DateTime @default(now())
  goalId             String
  debitTransactionId String?  @unique

  // --- Relações ---
  goal             Goal         @relation("GoalContribution_goal", fields: [goalId], references: [id], onDelete: Cascade)
  debitTransaction Transaction? @relation("GoalContribution_debitTransaction", fields: [debitTransactionId], references: [id], onDelete: SetNull)
}

model Achievement {
  id          String  @id @default(cuid())
  name        String
  description String
  icon        String  @db.LongText
  xp          Int
  trigger     String? // Ex: 'TRANSACTION_CREATED'
  criteria    Json? // Ex: { "count": 50, "category": "Alimentação" }

  // --- Relações ---
  unlockedBy UnlockedAchievement[]
}

model UnlockedAchievement {
  id            String   @id @default(cuid())
  destacada     Boolean  @default(false)
  unlockedAt    DateTime @default(now())
  userId        String
  achievementId String

  // --- Relações ---
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  relatedId String?
  actions   Json?
  userId    String
  createdAt DateTime         @default(now())

  // --- Relações ---
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CardAlert {
  id          String        @id @default(cuid())
  cardId      String
  userId      String
  type        AlertType
  severity    AlertSeverity
  title       String
  message     String
  metadata    Json?
  triggeredAt DateTime      @default(now())
  read        Boolean       @default(false)
  dismissed   Boolean       @default(false)

  // --- Relações ---
  card Card @relation("Card_Alerts", fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation("User_CardAlerts", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([cardId, triggeredAt])
}

model Automation {
  id            String         @id @default(cuid())
  type          AutomationType
  enabled       Boolean        @default(false)
  config        Json
  scheduleType  ScheduleType   @default(MANUAL)
  scheduleValue String?
  lastRun       DateTime?
  userId        String
  goalId        String?        @unique
  recorrenciaId String?

  // --- Relações ---
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal? @relation("GoalAutomation", fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([userId, type, recorrenciaId])
}

model RoundUpEntry {
  id            String    @id @default(cuid())
  transactionId String    @unique
  amount        Decimal   @db.Decimal(18, 4)
  processed     Boolean   @default(false)
  processedAt   DateTime?

  // --- Relações ---
  transaction Transaction @relation("RoundUpEntry_transaction", fields: [transactionId], references: [id], onDelete: Cascade)
}

model CategorizationRule {
  id            String        @id @default(cuid())
  keyword       String
  conditionType ConditionType @default(CONTAINS)
  createdAt     DateTime      @default(now())
  userId        String
  categoryId    String

  // --- Relações ---
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation("CategorizationRule_category", fields: [categoryId], references: [id], onDelete: Cascade)
}

model ImportTemplate {
  id      String @id @default(cuid())
  name    String
  mapping Json
  userId  String

  // --- Relações ---
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reconciliations Reconciliation[]
}

model Reconciliation {
  id                      String               @id @default(cuid())
  startDate               DateTime?
  endDate                 DateTime?
  status                  ReconciliationStatus @default(PROCESSING)
  filePath                String
  fileType                String
  totalJobs               Int                  @default(0)
  completedJobs           Int                  @default(0)
  balanceDifference       Decimal?             @db.Decimal(14, 2)
  statementOpeningBalance Decimal?             @db.Decimal(14, 2)
  statementClosingBalance Decimal?             @db.Decimal(14, 2)
  statementCurrency       String?              @default("BRL")
  statementTimezone       String?              @default("America/Sao_Paulo")
  systemOpeningBalance    Decimal?             @db.Decimal(14, 2)
  systemClosingBalance    Decimal?             @db.Decimal(14, 2)
  createdAt               DateTime             @default(now())
  userId                  String
  accountId               String?
  cardId                  String?
  importTemplateId        String?
  invoiceMonth            String?              // Formato: YYYY-MM, usado para reconciliação de faturas
  replaceMode             Boolean              @default(false) // Se true, delete & replace; se false, match individual

  // --- Relações ---
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account?              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  card                 Card?                 @relation(fields: [cardId], references: [id], onDelete: Cascade)
  importedTransactions ImportedTransaction[]
  importTemplate       ImportTemplate?       @relation(fields: [importTemplateId], references: [id], onDelete: SetNull)
}

model ImportedTransaction {
  id                  String                    @id @default(cuid())
  date                DateTime
  amount              Decimal                   @db.Decimal(18, 4)
  type                ImportedTransactionType
  description         String
  fitId               String                    @unique
  status              ImportedTransactionStatus @default(PENDING)
  reconciliationId    String
  manualTransactionId String?                   @unique
  similarityScore     Int?
  metadata            Json?

  // --- Relações ---
  reconciliation    Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  manualTransaction Transaction?   @relation("ManualToImportedTransaction", fields: [manualTransactionId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String         @id @default(cuid())
  action    String
  entity    String
  entityId  String
  details   Json
  status    AuditLogStatus @default(SUCCESS)
  origin    String         @default("WEB_APP")
  ipAddress String?
  createdAt DateTime       @default(now())
  userId    String

  // --- Relações ---
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Modelo para armazenar progresso da migração inicial
model MigrationDraft {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  currentStep   String?  // 'choice' | 'accounts' | 'investments' | 'cards' | 'card-history' | 'preview'
  accounts      Json?    @default("[]") // Array de contas
  cards         Json?    @default("[]") // Array de cartões
  cardHistory   Json?    @default("{}") // Objeto com histórico por índice de cartão
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
}

model AiAnalysis {
  id                     String         @id @default(cuid())
  type                   AiAnalysisType
  analysisText           String         @db.Text
  relevantTransactionIds String         @db.Text
  createdAt              DateTime       @default(now())
  userId                 String

  // --- Relações ---
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  nudgeConversions InvestmentNudgeConversion[]
}

model UserMission {
  id            String    @id @default(cuid())
  userId        String
  missionId     String
  acceptedAt    DateTime  @default(now())
  progressJson  Json?
  completedAt   DateTime?
  rewardClaimed Boolean   @default(false)

  // --- Relações ---
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
}

model Item {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  type      String
  bonusJson Json?
  rarity    String?
  createdAt DateTime @default(now())

  // --- Relações ---
  userItems  UserItem[]
  gameEvents GameEvent[]
}

model UserFavoriteCategory {
  id         String @id @default(cuid())
  userId     String
  categoryId String
  priority   Int    @default(0)

  // --- Relações ---
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@map("user_favorite_categories")
}

model CategoryClassification {
  id             String                     @id @default(cuid())
  userId         String
  categoryId     String
  classification CategoryClassificationType @default(OTHER)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  // --- Relações ---
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@index([userId, classification])
  @@map("category_classifications")
}


model UserDevice {
  id          String   @id @default(cuid())
  userId      String
  deviceId    String
  deviceName  String?
  platform    String?
  ipAddress   String?
  trusted     Boolean  @default(false)
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())

  // --- Relações ---
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@map("user_devices")
}

model SecurityEvent {
  id        String            @id @default(cuid())
  userId    String
  type      SecurityEventType
  message   String
  metadata  Json?
  createdAt DateTime          @default(now())

  // --- Relações ---
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("security_events")
}

model Boss {
  id         String    @id @default(cuid())
  name       String
  hp         BigInt
  currentHp  BigInt
  rewardJson Json
  isActive   Boolean   @default(false)
  startAt    DateTime?
  endAt      DateTime?
  createdAt  DateTime  @default(now())
}

model InvestmentPlan {
  id                  String               @id @default(cuid())
  priority            InvestmentPriority   @default(investir)
  targetPercent       Decimal              @default(0.2) @db.Decimal(5, 4)
  targetAmountMin     Decimal              @default(0) @db.Decimal(18, 2)
  targetAmount        Decimal?             @db.Decimal(18, 2)
  leisureFloor        Decimal              @default(0) @db.Decimal(18, 2)
  leisurePercentMin   Decimal              @default(0.15) @db.Decimal(5, 4)
  emergencyFundTarget Decimal?             @db.Decimal(18, 2)
  notes               String?              @db.Text
  status              InvestmentPlanStatus @default(ACTIVE)
  userId              String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // --- Relações ---
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings         InvestmentHolding[]
  contributions    InvestmentContribution[]
  snapshots        InvestmentSnapshot[]
  nudgeConversions InvestmentNudgeConversion[]

  @@unique([userId])
}

model InvestmentHolding {
  id             String   @id @default(cuid())
  planId         String
  userId         String
  accountId      String
  goalId         String?
  assetClass     String
  ticker         String?
  currentAmount  Decimal  @default(0) @db.Decimal(18, 4)
  expectedReturn Decimal? @db.Decimal(10, 4)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // --- Relações ---
  plan          InvestmentPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  account       Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  goal          Goal?                    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions InvestmentContribution[]
}

model InvestmentContribution {
  id                  String                       @id @default(cuid())
  planId              String
  userId              String
  accountId           String
  fromAccountId       String
  holdingId           String?
  amount              Decimal                      @db.Decimal(18, 4)
  leisureImpact       Decimal?                     @default(0) @db.Decimal(18, 4)
  status              InvestmentContributionStatus @default(EXECUTED)
  source              InvestmentContributionSource @default(MANUAL)
  notes               String?                      @db.Text
  analysisSnapshot    Json?
  debitTransactionId  String?                      @unique
  creditTransactionId String?                      @unique
  executedAt          DateTime?
  month               String
  createdAt           DateTime                     @default(now())

  // --- Relações ---
  plan               InvestmentPlan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationAccount Account            @relation("InvestmentContributionDestination", fields: [accountId], references: [id], onDelete: Cascade)
  sourceAccount      Account            @relation("InvestmentContributionSource", fields: [fromAccountId], references: [id], onDelete: Cascade)
  holding            InvestmentHolding? @relation(fields: [holdingId], references: [id], onDelete: SetNull)
  debitTransaction   Transaction?       @relation("InvestmentContributionDebit", fields: [debitTransactionId], references: [id], onDelete: SetNull)
  creditTransaction  Transaction?       @relation("InvestmentContributionCredit", fields: [creditTransactionId], references: [id], onDelete: SetNull)

  @@index([planId, month])
}

model InvestmentSnapshot {
  id              String   @id @default(cuid())
  planId          String
  userId          String
  month           String
  totalInvested   Decimal  @default(0) @db.Decimal(18, 4)
  totalReturns    Decimal  @default(0) @db.Decimal(18, 4)
  leisureSpent    Decimal  @default(0) @db.Decimal(18, 4)
  deltaVsPlan     Decimal  @default(0) @db.Decimal(18, 4)
  confidenceScore Decimal? @db.Decimal(5, 2)
  commentaryJson  Json?
  createdAt       DateTime @default(now())

  // --- Relações ---
  plan InvestmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([planId, month])
}

model InvestmentMetricSnapshot {
  id                         String   @id @default(cuid())
  month                      String
  soloPlanAdoptionPct        Decimal  @default(0) @db.Decimal(6, 4)
  avgContributionIncomeRatio Decimal  @default(0) @db.Decimal(10, 4)
  planAdherenceRate          Decimal  @default(0) @db.Decimal(6, 4)
  nudgeConversionRate        Decimal  @default(0) @db.Decimal(6, 4)
  adoptionRate               Decimal  @default(0) @db.Decimal(6, 4)
  churnRate                  Decimal  @default(0) @db.Decimal(6, 4)
  createdAt                  DateTime @default(now())

  @@unique([month])
}

model InvestmentNudgeConversion {
  id           String    @id @default(cuid())
  planId       String
  userId       String
  aiAnalysisId String
  targetAmount Decimal   @db.Decimal(18, 4)
  triggeredAt  DateTime
  convertedAt  DateTime?
  createdAt    DateTime  @default(now())

  // --- Relações ---
  plan       InvestmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiAnalysis AiAnalysis     @relation(fields: [aiAnalysisId], references: [id], onDelete: Cascade)
}
